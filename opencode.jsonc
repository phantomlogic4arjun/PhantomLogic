{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "grep *": "allow",
      "rm *": "deny"
    },
    "edit": "ask",
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask"
  },

  "agent": {
    "orchestrator": {
      "description": "Chief Orchestrator of Phantom Logic. Coordinates specialized agents and manages product delivery.",
      "mode": "primary",
      "temperature": 0.2,
      "prompt": "{file:./Agents/Orchestrator/Orchestrator.md}"
    },
    "productmanager": {
      "description": "Product Manager of Phantom Logic. Defines requirements, user stories, priorities, and acceptance criteria.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:./Agents/Product Manager/Product_Manager.md}",
      "permission": {
         "bash": "deny",
         "task": "deny"
       }
      },
    "architect": {
      "description": "Software Architect of Phantom Logic. Designs system architecture, databases, APIs, and technical solutions.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:./Agents/Architect/Architect.md}"
    },
    "designer": {
      "description": "UI/UX Designer of Phantom Logic. Designs user experiences, interfaces, wireframes, and design systems.",
      "mode": "subagent",
      "temperature": 0.3,
      "prompt": "{file:./Agents/Designer/Designer.md}"
    },
    "developer": {
      "description": "Software Developer of Phantom Logic. Implements features, writes code, and maintains application quality.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:./Agents/Developer/Developer.md}"
    },
    "qa": {
      "description": "Quality Assurance Engineer of Phantom Logic. Plans and executes tests and verifies product quality.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:./Agents/QA/QA.md}"
    },
    "security": {
      "description": "Security Engineer of Phantom Logic. Reviews application security, vulnerabilities, and data protection.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:./Agents/Security/Security.md}"
    },
    "devops": {
      "description": "DevOps Engineer of Phantom Logic. Manages development environments, builds, deployments, and infrastructure.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:./Agents/Devops/Devops.md}"
    }
  }
}
